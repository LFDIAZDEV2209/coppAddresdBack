{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "LEARNINGS.md"],
  "skills": {
    "paths": [
      ".agents/skills",
      "../.agents/skills",
      "../antares-paciente/.agents/skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    },
    "lsp": "allow"
  },
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  }
}
