{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  }
}
