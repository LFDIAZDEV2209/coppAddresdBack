{
  // ======================================================================
  // CoppAddresd.Auth - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores con tus credenciales de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // Este archivo de ejemplo es la única referencia versionada de qué configurar.
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5080"
  },
  "ConnectionStrings": {
    // Usar la cadena de conexión de tu PostgreSQL local (no versionar credenciales reales).
    "DefaultConnection": "Host=localhost;Port=5432;Database=coppaddresd;Username=USER;Password=PASSWORD;MaxPoolSize=100;Timeout=30;CommandTimeout=60"
  },
  "Jwt": {
    // Mínimo 32 caracteres. Debe ser idéntico en la API principal y el Auth Service.
    "Secret": "change-this-to-a-secure-secret-key-at-least-32-chars-long",
    "Issuer": "CoppAddresd.Auth",
    "ValidAudiences": ["erp", "app"],
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Auth": {
    "AdminEmail": "admin@coppaddresd.com",
    "AdminPassword": "Test@1234",
    "AdminFirstName": "Admin",
    "AdminLastName": "System"
  },
  // ======================================================================
  // Twilio Verify V2 (OTP por SMS)
  // ----------------------------------------------------------------------
  // IsEnabled = true  -> la app valida al arrancar que las 4 credenciales
  //                      estén presentes (obligatorias).
  // IsEnabled = false -> la app arranca sin Twilio (Development sin fallar).
  //
  // En producción NO pongas los valores aquí: usa variables de entorno con
  // la convención estándar de ASP.NET Core (sección con '__'), igual que
  // ConnectionStrings__DefaultConnection:
  //
  //   TWILIO__IS_ENABLED           = true
  //   TWILIO__ACCOUNT_SID          = ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  //   TWILIO__API_KEY_SID          = SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  //   TWILIO__API_KEY_SECRET       = <API Key Secret de Twilio>
  //   TWILIO__VERIFY_SERVICE_SID   = VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  // ======================================================================
  "Twilio": {
    "IsEnabled": false,
    "AccountSid": "",
    "ApiKeySid": "",
    "ApiKeySecret": "",
    "VerifyServiceSid": ""
  },
  // ======================================================================
  // Seguridad del flujo OTP (send-otp / verify-otp)
  // ----------------------------------------------------------------------
  // Límites de protección por IP, teléfono y documento, cooldown de reenvío
  // e intentos fallidos para el canal PHONE. En esta etapa la configuración
  // existe pero el mecanismo aún NO está implementado (fase posterior).
  //
  // Los valores se pueden sobreescribir con variables de entorno usando la
  // convención estándar de ASP.NET Core (sección con '__'), igual que
  // TWILIO__*:
  //
  //   OTPSECURITY__ENABLED                      = true
  //   OTPSECURITY__SEND_PER_IP_PER_MINUTE       = 5
  //   OTPSECURITY__SEND_PER_IP_PER_HOUR         = 30
  //   OTPSECURITY__SEND_PER_PHONE_PER_MINUTE    = 3
  //   OTPSECURITY__SEND_PER_PHONE_PER_HOUR      = 10
  //   OTPSECURITY__SEND_PER_PHONE_PER_DAY       = 20
  //   OTPSECURITY__SEND_PHONE_COOLDOWN_SECONDS  = 60
  //   OTPSECURITY__SEND_PER_DOCUMENT_PER_HOUR   = 5
  //   OTPSECURITY__VERIFY_PER_IP_PER_MINUTE     = 30
  //   OTPSECURITY__VERIFY_PER_PHONE_WINDOW_MINUTES = 5
  //   OTPSECURITY__VERIFY_PER_PHONE_LIMIT       = 10
  //   OTPSECURITY__VERIFY_PHONE_MAX_FAILED_ATTEMPTS = 5
  //   OTPSECURITY__VERIFY_PHONE_LOCKOUT_SECONDS = 300
  // ======================================================================
  "OtpSecurity": {
    "Enabled": true,
    "SendPerIpPerMinute": 5,
    "SendPerIpPerHour": 30,
    "SendPerPhonePerMinute": 3,
    "SendPerPhonePerHour": 10,
    "SendPerPhonePerDay": 20,
    "SendPhoneCooldownSeconds": 60,
    "SendPerDocumentPerHour": 5,
    "VerifyPerIpPerMinute": 30,
    "VerifyPerPhoneWindowMinutes": 5,
    "VerifyPerPhoneLimit": 10,
    "VerifyPhoneMaxFailedAttempts": 5,
    "VerifyPhoneLockoutSeconds": 300
  }
}
