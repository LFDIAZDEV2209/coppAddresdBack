{
  // ======================================================================
  // CoppAddresd.Telemedicine - Configuración de ejemplo (PARCIAL)
  // Este archivo NO es una configuración completa para arrancar el servicio:
  // solo versiona el contrato de LOGGING (Logging + Serilog). Para bootear se
  // requieren además: ConnectionStrings, Jwt, Telemedicine, Twilio y Cors —
  // copialas desde tu appSettings.Development.json local (no versionado).
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // ======================================================================
  // Logging estructurado (Serilog) — contrato versionado para el equipo/CI.
  // ----------------------------------------------------------------------
  // Si existe una sección "Serilog" con WriteTo, el host la usa tal cual
  // (Console + File compact-JSON con rotación diaria). Si NO existe
  // (entornos sin configuración Serilog), el Program.cs cae a console-only
  // con MinimumLevel.Override Microsoft.AspNetCore=Warning y el mismo
  // outputTemplate con {Properties:j} (CorrelationId/RequestPath visibles).
  // En Development, appSettings.Development.json define esta misma sección.
  // ======================================================================
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Formatting.Compact"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tele-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
