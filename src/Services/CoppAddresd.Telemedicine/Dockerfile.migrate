# =========================
# MIGRATOR — aplica migraciones EF del Telemedicine contra RDS (one-off)
# =========================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY . .

RUN dotnet tool install --global dotnet-ef

ENV PATH="$PATH:/root/.dotnet/tools"

RUN dotnet restore "src/Services/CoppAddresd.Telemedicine/CoppAddresd.Telemedicine.csproj"

ENTRYPOINT ["dotnet", "ef", "database", "update", "--project", "src/Services/CoppAddresd.Telemedicine/CoppAddresd.Telemedicine.csproj", "--startup-project", "src/Services/CoppAddresd.Telemedicine/CoppAddresd.Telemedicine.csproj"]