{
  // ======================================================================
  // CoppAddresd.Gateway - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // En producción, InternalKey:Key sale de Secrets Manager (variable de entorno).
  // ======================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",

  // Orígenes permitidos por CORS (frontend web + app móvil).
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "capacitor://localhost",
      "ionic://localhost"
    ]
  },

  // Clave interna compartida con los backends para endpoints /internal/*.
  // En producción usar Secrets Manager (variable de entorno InternalKey__Key).
  "InternalKey": {
    "Enabled": true,
    "Key": "change-me-internal-key-from-secrets-manager"
  },

  // Base de cada cluster usada por la sonda activa de /health del gateway.
  "Clusters": {
    "Auth": { "BaseUrl": "http://localhost:5123", "HealthCheckPath": "/health" },
    "Api": { "BaseUrl": "http://localhost:5122", "HealthCheckPath": "/health" },
    "Telemedicine": { "BaseUrl": "http://localhost:5130", "HealthCheckPath": "/health" }
  },

  // Configuración declarativa de YARP (rutas + clusters + health checks).
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "auth",
        "Priority": 100,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      // El Auth Service consolida todos sus endpoints bajo /api/auth/{**catch-all}
      // (authRoute): /api/auth/login|refresh|logout, /api/auth/me, /api/auth/users,
      // /api/auth/roles, /api/auth/permissions, /api/auth/invitations y
      // /api/auth/internal/*. No hacen falta rutas extra fuera de ese prefijo.
      // Nota de prioridades: en YARP una ruta con Priority MÁS ALTO se evalúa PRIMERO.
      // telemedRoute debe vencer a apiRoute (su catch-all también casa /api/v1/telemedicine/*),
      // por eso telemedRoute lleva el priority más alto (300) y apiRoute 200.
      "telemedRoute": {
        "ClusterId": "telemedicine",
        "Priority": 300,
        "Match": { "Path": "/api/v1/telemedicine/{**catch-all}" }
      },
      "apiRoute": {
        "ClusterId": "api",
        "Priority": 200,
        "Match": { "Path": "/api/v1/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "primary": { "Address": "http://localhost:5123/" } },
        "HttpClient": { "DangerousAcceptAnyServerCertificate": false }
      },
      "api": {
        "Destinations": { "primary": { "Address": "http://localhost:5122/" } },
        "HttpClient": { "Timeout": "00:05:00" },
        // SSE: ActivityTimeout alto para no cortar streams con pausas >100s entre eventos.
        "HttpRequest": { "ActivityTimeout": "00:10:00" }
      },
      "telemedicine": {
        "Destinations": { "primary": { "Address": "http://localhost:5130/" } }
      }
    },
    "HealthCheck": {
      "AvailableDestinationsPolicy": "HealthyOrDegraded",
      "Active": {
        "Enabled": true,
        "Interval": "00:00:30",
        "Timeout": "00:00:05",
        "Policy": "ConsecutiveFailures",
        "Path": "/health"
      },
      "Passive": {
        "Enabled": true,
        "Policy": "TransportFailureRatePerRequest",
        "ReactivationPeriod": "00:00:30"
      }
    }
  }
}
