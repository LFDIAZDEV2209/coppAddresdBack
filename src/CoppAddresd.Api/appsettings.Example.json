{
  // ======================================================================
  // CoppAddresd.Api - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores con tus credenciales de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // Este archivo de ejemplo es la única referencia versionada de qué configurar.
  //
  // Las secciones restantes (AiService, Fcm, AuthService, PostalCodeLookup,
  // Storage:S3, etc.) siguen la forma de tu appsettings.Development.json local.
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5080"
  },
  "ConnectionStrings": {
    // Usar la cadena de conexión de tu PostgreSQL local (no versionar credenciales reales).
    "DefaultConnection": "Host=localhost;Port=5432;Database=coppaddresd;Username=USER;Password=PASSWORD;MaxPoolSize=100;Timeout=30;CommandTimeout=60"
  },
  "Jwt": {
    // Mínimo 32 caracteres. Debe ser idéntico en la API principal y el Auth Service.
    "Secret": "change-this-to-a-secure-secret-key-at-least-32-chars-long",
    "Issuer": "CoppAddresd.Auth",
    "ValidAudiences": ["erp", "app"]
  },
  "Storage": {
    // Obligatorio al arrancar (fail-fast). Secreto de firma de URLs firmadas.
    "Provider": "Local",
    "SignatureKey": "change-this-to-a-secure-signature-key"
  },
  // ======================================================================
  // Programa de 83 semanas (Program Progress)
  // ----------------------------------------------------------------------
  // Code es el identificador de la plantilla por defecto que siembra
  // ProgramProgressSeeder al arrancar (idempotente). Si no se configura,
  // el seeder usa "default-83w" como fallback.
  // ======================================================================
  "Program": {
    "DefaultTemplate": {
      "Code": "default-83w"
    }
  }
}