{
  // ======================================================================
  // CoppAddresd.Api - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores con tus credenciales de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // Este archivo de ejemplo es la única referencia versionada de qué configurar.
  //
  // Las secciones restantes (AiService, Fcm, AuthService, PostalCodeLookup,
  // Storage:S3, etc.) siguen la forma de tu appsettings.Development.json local.
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5080"
  },
  "ConnectionStrings": {
    // Usar la cadena de conexión de tu PostgreSQL local (no versionar credenciales reales).
    "DefaultConnection": "Host=localhost;Port=5432;Database=coppaddresd;Username=USER;Password=PASSWORD;MaxPoolSize=100;Timeout=30;CommandTimeout=60",
    // Valkey local del docker-compose (127.0.0.1, NO localhost: evita resolver a IPv6).
    // En producción: endpoint de ElastiCache for Valkey + AUTH token.
    "Valkey": "127.0.0.1:6379,password=VALKEY_PASSWORD"
  },
  // Caché distribuida (Valkey) — docs: docs/modules/cache/README.md
  //   Provider: Valkey (default) | Memory (tests/proceso único) | None (rollback).
  //   KeyPrefix: namespace de claves (erp). En prod: CACHE__PROVIDER y
  //   CONNECTIONSTRINGS__VALKEY como variables de entorno.
  "Cache": {
    "Provider": "Valkey",
    "KeyPrefix": "erp"
  },
  "Jwt": {
    // Mínimo 32 caracteres. Debe ser idéntico en la API principal y el Auth Service.
    "Secret": "change-this-to-a-secure-secret-key-at-least-32-chars-long",
    "Issuer": "CoppAddresd.Auth",
    "ValidAudiences": ["erp", "app"]
  },
  "Storage": {
    // Obligatorio al arrancar (fail-fast). Secreto de firma de URLs firmadas.
    // "Provider": "Local" usa el proxy del backend (dev); "S3" usa AWS (prod).
    "Provider": "S3",
    "SignatureKey": "coppaddresd-dev-storage-signature-key-change-in-prod",
    "MaxFileSizeBytes": 20971520,
    "AllowedWritePrefixes": ["agents/", "media/"],
    "AllowedDocumentContentTypes": [
      "text/markdown",
      "text/plain",
      "text/x-rst",
      "application/pdf",
      "application/octet-stream"
    ],
    "StaleProcessingThresholdMinutes": 60,
    "Local": { "RootPath": "" },
    "S3": {
      "Region": "us-east-2",
      "Bucket": "cooppadresd-storage-prod",
      "BucketArn": "arn:aws:s3:::cooppadresd-storage-prod",
      "ObjectArn": "arn:aws:s3:::cooppadresd-storage-prod/*",
      "IamRole": "cooppadresd-ec2-s3-access-role",
      "ServiceUrl": "",
      "ForcePathStyle": false
    }
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiPrefix": "/api/v1",
    "TimeoutSeconds": 120
  },
  "AuthService": {
    "BaseUrl": "http://localhost:5123",
    "InternalApiKey": "coppaddresd-internal-dev-key-change-in-prod",
    "TimeoutSeconds": 10
  },
  "PostalCodeLookup": {
    "Enabled": true,
    "BaseUrl": "https://api.zippopotam.us",
    "TimeoutSeconds": 3,
    "CacheTtlMinutes": 1440
  },
  // ======================================================================
  // Programa de 83 semanas (Program Progress)
  // ----------------------------------------------------------------------
  // Code es el identificador de la plantilla por defecto que siembra
  // ProgramProgressSeeder al arrancar (idempotente). Si no se configura,
  // el seeder usa "default-83w" como fallback.
  // ======================================================================
  "Program": {
    "DefaultTemplate": {
      "Code": "default-83w"
    }
  },
  "Email": {
    "Provider": "Log",
    "Enabled": true,
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@coppaddresd.com",
    "FromName": "COPP-ADRESD"
  }
}
