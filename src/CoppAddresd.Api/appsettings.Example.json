{
  // ======================================================================
  // CoppAddresd.Api - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores con tus credenciales de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // Este archivo de ejemplo es la única referencia versionada de qué configurar.
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=coppaddresd;Username=USER;Password=PASSWORD;MaxPoolSize=100;Timeout=30;CommandTimeout=60"
  },
  "Storage": {
    "Provider": "S3",
    "SignatureKey": "coppaddresd-dev-storage-signature-key-change-in-prod",
    "MaxFileSizeBytes": 20971520,
    "AllowedWritePrefixes": ["agents/", "media/"],
    "AllowedDocumentContentTypes": [
      "text/markdown",
      "text/plain",
      "text/x-rst",
      "application/pdf",
      "application/octet-stream"
    ],
    "StaleProcessingThresholdMinutes": 60,
    "Local": { "RootPath": "" },
    "S3": {
      "Region": "us-east-2",
      "Bucket": "cooppadresd-storage-prod",
      "BucketArn": "arn:aws:s3:::cooppadresd-storage-prod",
      "ObjectArn": "arn:aws:s3:::cooppadresd-storage-prod/*",
      "IamRole": "cooppadresd-ec2-s3-access-role",
      "ServiceUrl": "",
      "ForcePathStyle": false
    }
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiPrefix": "/api/v1",
    "TimeoutSeconds": 120
  },
  "AuthService": {
    "BaseUrl": "http://localhost:5123",
    "InternalApiKey": "coppaddresd-internal-dev-key-change-in-prod",
    "TimeoutSeconds": 10
  },
  "Jwt": {
    "Secret": "change-this-to-a-secure-secret-key-at-least-32-chars-long",
    "Issuer": "CoppAddresd.Auth",
    "ValidAudiences": ["erp", "app"]
  },
  "PostalCodeLookup": {
    "Enabled": true,
    "BaseUrl": "https://api.zippopotam.us",
    "TimeoutSeconds": 3,
    "CacheTtlMinutes": 1440
  }
}