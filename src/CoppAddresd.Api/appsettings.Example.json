{
  // ======================================================================
  // CoppAddresd.Api - Configuración de ejemplo
  // Copia este archivo a appsettings.json (o appsettings.{Environment}.json)
  // y completa los valores con tus credenciales de DESARROLLO.
  //
  // NUNCA commitees appsettings.json ni credenciales reales (están en .gitignore).
  // Este archivo de ejemplo es la única referencia versionada de qué configurar.
  //
  // Las secciones restantes (AiService, Fcm, AuthService, PostalCodeLookup,
  // Storage:S3, etc.) siguen la forma de tu appsettings.Development.json local.
  // ======================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // ======================================================================
  // Logging estructurado (Serilog) — contrato versionado para el equipo/CI.
  // ----------------------------------------------------------------------
  // Si existe una sección "Serilog" con WriteTo, el host la usa tal cual
  // (Console + File compact-JSON con rotación diaria). Si NO existe
  // (entornos sin configuración Serilog), el Program.cs cae a console-only
  // con MinimumLevel.Override Microsoft.AspNetCore=Warning y el mismo
  // outputTemplate con {Properties:j} (CorrelationId/RequestPath visibles).
  // En Development, appsettings.Development.json define esta misma sección.
  // ======================================================================
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Formatting.Compact"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5080"
  },
  "ConnectionStrings": {
    // Usar la cadena de conexión de tu PostgreSQL local (no versionar credenciales reales).
    "DefaultConnection": "Host=localhost;Port=5432;Database=coppaddresd;Username=USER;Password=PASSWORD;MaxPoolSize=100;Timeout=30;CommandTimeout=60",
    // Valkey local del docker-compose (127.0.0.1, NO localhost: evita resolver a IPv6).
    // En producción: endpoint de ElastiCache for Valkey + AUTH token.
    "Valkey": "127.0.0.1:6379,password=VALKEY_PASSWORD"
  },
  // Caché distribuida (Valkey) — docs: docs/modules/cache/README.md
  //   Provider: Valkey (default) | Memory (tests/proceso único) | None (rollback).
  //   KeyPrefix: namespace de claves (erp). En prod: CACHE__PROVIDER y
  //   CONNECTIONSTRINGS__VALKEY como variables de entorno.
  "Cache": {
    "Provider": "Valkey",
    "KeyPrefix": "erp"
  },
  "Jwt": {
    // Mínimo 32 caracteres. Debe ser idéntico en la API principal y el Auth Service.
    "Secret": "change-this-to-a-secure-secret-key-at-least-32-chars-long",
    "Issuer": "CoppAddresd.Auth",
    "ValidAudiences": ["erp", "app"]
  },
  "Storage": {
    // Obligatorio al arrancar (fail-fast). Secreto de firma de URLs firmadas.
    // "Provider": "Local" usa el proxy del backend (dev); "S3" usa AWS (prod).
    "Provider": "S3",
    "SignatureKey": "coppaddresd-dev-storage-signature-key-change-in-prod",
    "MaxFileSizeBytes": 20971520,
    "AllowedWritePrefixes": ["agents/", "media/"],
    "AllowedDocumentContentTypes": [
      "text/markdown",
      "text/plain",
      "text/x-rst",
      "application/pdf",
      "application/octet-stream"
    ],
    "StaleProcessingThresholdMinutes": 60,
    "Local": { "RootPath": "" },
    "S3": {
      "Region": "us-east-2",
      "Bucket": "cooppadresd-storage-prod",
      "BucketArn": "arn:aws:s3:::cooppadresd-storage-prod",
      "ObjectArn": "arn:aws:s3:::cooppadresd-storage-prod/*",
      "IamRole": "cooppadresd-ec2-s3-access-role",
      "ServiceUrl": "",
      "ForcePathStyle": false
    }
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiPrefix": "/api/v1",
    "TimeoutSeconds": 120
  },
  "AuthService": {
    "BaseUrl": "http://localhost:5123",
    "InternalApiKey": "coppaddresd-internal-dev-key-change-in-prod",
    "TimeoutSeconds": 10
  },
  "PostalCodeLookup": {
    "Enabled": true,
    "BaseUrl": "https://api.zippopotam.us",
    "TimeoutSeconds": 3,
    "CacheTtlMinutes": 1440
  },
  // ======================================================================
  // Programa de 83 semanas (Program Progress)
  // ----------------------------------------------------------------------
  // Code es el identificador de la plantilla por defecto que siembra
  // ProgramProgressSeeder al arrancar (idempotente). Si no se configura,
  // el seeder usa "default-83w" como fallback.
  // ======================================================================
  "Program": {
    "DefaultTemplate": {
      "Code": "program-coppaddresd-83-days"
    },
    // ======================================================================
    // Recordatorios de hitos del programa (Program Milestone Reminder)
    // ----------------------------------------------------------------------
    // Job periódico que envía push FCM + mensaje proactivo en el chat a
    // pacientes con inscripción activa en los días 7/14/21/45/60/90 del
    // programa (día 1 = start_local_date). Ventana de entrega en hora local
    // del paciente (StartLocalHour inclusive, EndLocalHour exclusive) y días
    // de gracia tras el día exacto. Idempotente: cada (inscripción, día) se
    // notifica como máximo una vez (tabla app.program_milestone_sends).
    // ======================================================================
    "MilestoneSender": {
      "Enabled": true,
      "TickMinutes": 60,
      "StartLocalHour": 9,
      "EndLocalHour": 21,
      "GraceDays": 3,
      "MaxAttempts": 3,
      "Days": [7, 14, 21, 45, 60, 90],
      "Templates": [
        { "Day": 7,  "AgentTypeId": "base", "Title": "💬 ¡Llegaste al día 7!", "Message": "¡Hola! Ya completaste 7 días del programa. 💪 Queremos saber cómo te sentís: contanos si pudiste cumplir tus tareas diarias y qué barreras encontraste. Si algo se te dificulta, escribinos y te ayudamos a ajustar el plan. ¡Tu constancia ya se nota!" },
        { "Day": 14, "AgentTypeId": "base", "Title": "🌟 ¡14 días de progreso!", "Message": "¡Dos semanas adentro del programa! 🎉 Queremos saber cómo viene tu energía y tus hábitos. Recordá que los pequeños ajustes a tiempo hacen grandes diferencias: si tenés dudas sobre tu rutina, contanos y te orientamos." },
        { "Day": 21, "AgentTypeId": "base", "Title": "💊 Día 21: revisemos tus hábitos", "Message": "¡Llegaste al día 21! 🏆 Es un gran momento para revisar cómo te sentís con el plan. ¿Notaste cambios? Si algo no te funciona o tenés molestias, te recomendamos agendar una cita con tu profesional para ajustar el rumbo a tiempo." },
        { "Day": 45, "AgentTypeId": "base", "Title": "📊 ¡Día 45! Momento de evaluar", "Message": "¡Ya llevás 45 días! 📈 Este es un punto clave del programa. ¿Cómo te sentís con tus resultados hasta ahora? Si querés, agendá una consulta para revisar tu progreso y planear juntos los próximos pasos." },
        { "Day": 60, "AgentTypeId": "base", "Title": "⚡ Día 60: casi en la meta", "Message": "¡60 días de constancia! ⚡ Felicitaciones por llegar hasta acá. Contanos cómo te sentís: si notás estancamiento o fatiga, una cita con tu profesional puede ayudarte a retomar el impulso. ¡No aflojes!" },
        { "Day": 90, "AgentTypeId": "base", "Title": "🏁 ¡Día 90! Gran hito del programa", "Message": "¡Completaste 90 días del programa! 🏁 Es momento de evaluar tus resultados de cerca: agendá una cita para revisar tus métricas y decidir cómo seguir cuidándote. ¡Felicitaciones por tu compromiso!" }
      ]
    }
  },
  // ======================================================================
  // Paciente dev para el seeder de desarrollo (DevProgramSeeder)
  // ----------------------------------------------------------------------
  // Si se configura, al arrancar la API la paciente (por email, status='Activo')
  // se inscribe en el programa default-83w y recibe un plan de alimentación y
  // rutinas de 4 semanas. Si se omite o queda vacío, el seeder no hace nada.
  // ======================================================================
  "DevPatient": {
    "Email": "maria.gonzalez@example.com"
  },
  "Email": {
    "Provider": "Log",
    "Enabled": true,
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@coppaddresd.com",
    "FromName": "COPP-ADRESD"
  }
}
