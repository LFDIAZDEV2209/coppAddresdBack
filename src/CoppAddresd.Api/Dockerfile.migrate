# =========================
# MIGRATOR — aplica migraciones EF del API contra RDS (one-off)
# =========================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY . .

RUN dotnet tool install --global dotnet-ef

ENV PATH="$PATH:/root/.dotnet/tools"

RUN dotnet restore "src/CoppAddresd.Api/CoppAddresd.Api.csproj"

ENTRYPOINT ["dotnet", "ef", "database", "update", "--project", "src/CoppAddresd.Api/CoppAddresd.Api.csproj", "--startup-project", "src/CoppAddresd.Api/CoppAddresd.Api.csproj"]